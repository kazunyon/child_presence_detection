# Never commit real values. Configure these in Render / GitHub Actions secrets.
DATABASE_URL=postgresql+psycopg://user:password@host:5432/mamoru_bus
JWT_SECRET=replace-with-a-long-random-secret
TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=https://kazunyon.github.io
ENVIRONMENT=production
VITE_API_BASE_URL=https://your-api.onrender.com
# LINE Messaging API for バナナ幼稚園 (@408mrkbk). Never expose secrets to the browser.
LINE_CHANNEL_ACCESS_TOKEN=replace-with-line-channel-access-token
LINE_CHANNEL_SECRET=replace-with-line-channel-secret
LINE_BASIC_ID=@408mrkbk
LINE_OFFICIAL_ACCOUNT_NAME=バナナ幼稚園
LINE_LINK_TOKEN_PEPPER=replace-with-a-long-random-secret
LINE_LINK_EXPIRE_HOURS=24
# The organization ID which owns this LINE Official Account. Use 1 only for fresh development data.
LINE_ORGANIZATION_ID=1
# Provider-neutral email webhook. Receives subject/message/link_url/qr_png_data_url JSON.
EMAIL_WEBHOOK_URL=https://example.com/mamoru-bus-email
EMAIL_FROM_ADDRESS=noreply@example.jp
# Keep false until test LINE/email accounts complete end-to-end verification.
NOTIFICATION_FEATURE_ENABLED=false
# Retained for non-email/non-LINE webhook notifications.
NOTIFICATION_WEBHOOK_URL=https://example.com/mamoru-bus-webhook
UPLOAD_DIR=/var/data/mamoru-bus-uploads
# One-time administrator PIN recovery. Set a unique random value in Render, use it once, then remove it.
ADMIN_PIN_RECOVERY_TOKEN=replace-with-a-long-random-recovery-token
